---
import LayoutPage from "@layouts/LayoutPage.astro";
import ResumeMenu from "@components/ResumeMenu";
---

<LayoutPage
  title="Resume | Chris Simmons"
  description="Resume for Chris Simmons, senior frontend developer and design engineer, creator of Skeleton."
>
  <main class="p-4">
    <div class="container mx-auto">
      <!-- Fill the viewport: 100dvh minus header (5rem), stripes (2rem), main padding (2rem). On mobile the h1 takes an auto row above the doc. -->
      <div class="grid grid-cols-1 grid-rows-[auto_minmax(0,1fr)] md:grid-cols-[48px_auto_1fr] md:grid-rows-1 gap-4 md:gap-8 h-[calc(100dvh-9rem)] min-h-96">
        <!-- Heading 1 -->
        <h1 class="h1 md:[writing-mode:vertical-rl] md:rotate-180 md:self-start">
          <span>RESUME</span>
        </h1>
        <!-- Horz Rule -->
        <div class="hidden md:block">
          <hr class="vr border-dashed" />
        </div>
        <div class="min-h-0">
          <!-- Resume -->
          <section class="flex flex-col gap-4 h-full">
            <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <p class="opacity-60">
                Tap the button on right for more view options.
              </p>
              <ResumeMenu client:load />
            </header>
            <iframe
              class="bg-white shadow-xl rounded-lg w-full flex-1 min-h-0"
              title="Chris Simmons resume"
              loading="lazy"
              src="https://docs.google.com/document/d/e/2PACX-1vTXIHHD4NuQLXrSOJheUW6R-fJIKDrvt0R8VE5o9E1VmP7jTYybQziw01PC45jvAtM3-WP9CzqyRjXc/pub?embedded=true"
            ></iframe>
          </section>
        </div>
      </div>
    </div>
  </main>
</LayoutPage>
